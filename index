<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#176b9b">
<title>Giáo dục học | Học dễ hiểu</title>
<style>
:root{--blue:#176b9b;--blue-dark:#104d72;--sky:#eaf5fc;--bg:#f5f8fb;--ink:#183246;--muted:#607789;--line:#dce7ef;--white:#fff;--green:#16764b;--red:#b13c45;--amber:#956315;--shadow:0 4px 18px rgba(23,67,95,.07)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,"Segoe UI",sans-serif;font-size:17px;line-height:1.7;-webkit-text-size-adjust:100%}
button,input,textarea{font:inherit}button{border:0;border-radius:13px;padding:12px 17px;background:var(--blue);color:white;font-weight:700;cursor:pointer;min-height:46px}button:active{transform:scale(.985)}button.light{background:var(--sky);color:var(--blue)}button.outline{background:white;color:var(--blue);border:1px solid var(--line)}button:disabled{opacity:.45}
header{background:linear-gradient(135deg,#eaf6fd,#dceefa);padding:24px max(18px,calc((100vw - 940px)/2)) 22px;border-bottom:1px solid var(--line)}
.brand{font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--blue);text-transform:uppercase}h1{font-size:clamp(27px,5vw,38px);line-height:1.2;letter-spacing:-.03em;margin:7px 0}header p{margin:0;color:#4e6c80;max-width:720px;font-size:16px}
main{max-width:940px;margin:auto;padding:20px 16px 100px}.screen{display:none}.screen.active{display:block}
.welcome{background:white;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:var(--shadow);margin-bottom:16px}.welcome h2{font-size:23px;margin:0 0 5px}.welcome p{margin:0;color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.stat{background:white;border:1px solid var(--line);border-radius:15px;padding:12px;text-align:center}.stat strong{display:block;color:var(--blue);font-size:25px;line-height:1.2}.stat span{font-size:13px;color:var(--muted)}
.progress{height:9px;background:#e6eef4;border-radius:20px;overflow:hidden;margin:12px 0}.progress i{display:block;height:100%;background:#2788b9;border-radius:20px}
.section-title{font-size:23px;margin:22px 0 9px;letter-spacing:-.02em}.sub{color:var(--muted);font-size:15px;margin:0 0 14px}
.path{display:grid;gap:12px}.pathcard{display:flex;gap:14px;align-items:flex-start;text-align:left;background:white;color:var(--ink);border:1px solid var(--line);padding:17px;border-radius:17px;box-shadow:var(--shadow);width:100%}.num{flex:0 0 38px;height:38px;border-radius:12px;background:var(--sky);color:var(--blue);display:grid;place-items:center;font-weight:800}.pathcard b{display:block;font-size:18px}.pathcard small{display:block;color:var(--muted);font-size:14px;font-weight:400;line-height:1.45;margin-top:3px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.toolbar button{font-size:14px;padding:9px 13px;min-height:40px}
.box{background:white;border:1px solid var(--line);border-radius:18px;padding:19px;margin:12px 0;box-shadow:var(--shadow)}.box h2{font-size:23px;line-height:1.35;margin:0 0 9px}.box h3{font-size:19px;margin:16px 0 6px}.muted{color:var(--muted)}.tag{display:inline-block;padding:3px 10px;border-radius:99px;background:var(--sky);color:var(--blue);font-size:12px;font-weight:800;margin-bottom:7px}
.lesson-list{display:grid;gap:10px}.lesson{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden}.lesson summary{list-style:none;padding:16px;cursor:pointer;font-weight:750;font-size:17px;display:flex;gap:12px;align-items:center}.lesson summary::-webkit-details-marker{display:none}.lesson summary:after{content:"＋";margin-left:auto;color:var(--blue);font-size:20px}.lesson[open] summary:after{content:"−"}.lesson-content{padding:0 16px 17px}.explain{background:#f0f7fb;border-left:4px solid #5ba1c7;padding:13px 14px;border-radius:9px;margin:12px 0}.remember{background:#fff8e9;border-left:4px solid #d5a044;padding:13px 14px;border-radius:9px;margin:12px 0}.remember b{color:#7c5615}.keyword{font-weight:800;color:#1c668e}
.modegrid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.mode{background:white;color:var(--ink);border:1px solid var(--line);border-radius:16px;text-align:left;padding:16px;box-shadow:var(--shadow)}.mode .emoji{font-size:25px}.mode b{display:block;font-size:17px;margin:5px 0}.mode small{color:var(--muted);font-size:14px;line-height:1.4}
.question{background:white;border:1px solid var(--line);border-radius:18px;padding:19px;box-shadow:var(--shadow);margin:13px 0}.qtop{display:flex;justify-content:space-between;color:var(--muted);font-size:14px;gap:10px}.qtext{font-size:20px;font-weight:750;line-height:1.45;margin:14px 0}.choice{display:flex;align-items:flex-start;gap:11px;padding:13px;border:1px solid var(--line);border-radius:13px;margin:9px 0;cursor:pointer;background:white}.choice input{width:19px;height:19px;accent-color:var(--blue);margin-top:4px;flex:0 0 auto}.choice:has(input:checked){border-color:#64a6ca;background:#f1f8fc}.feedback{padding:13px;border-radius:12px;margin-top:13px;font-size:15px}.good{background:#eaf7f0;color:#176b45}.bad{background:#fff0f0;color:#a3343b}
.answer{display:none}.answer.show{display:block}.field{width:100%;border:1px solid #cbdbe6;border-radius:13px;padding:13px;background:white;color:var(--ink);font-size:17px}.field:focus{outline:3px solid #d7ebf7;border-color:#5b9ec4}.navrow{display:flex;gap:9px;flex-wrap:wrap;justify-content:space-between;margin-top:14px}.navrow button{flex:1}
.flashcard{min-height:245px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:linear-gradient(145deg,#fff,#f1f8fc);border:1px solid var(--line);border-radius:20px;padding:25px;margin:14px 0}.flashcard .front{font-size:23px;font-weight:800;line-height:1.45}.flashcard .back{font-size:18px;margin-top:17px}
textarea{min-height:130px;resize:vertical}
.bottomnav{display:none}
.note{font-size:14px;color:var(--muted)}
@media(max-width:640px){
 body{font-size:17px}header{padding:20px 17px}header p{font-size:15px}main{padding:14px 12px calc(100px + env(safe-area-inset-bottom))}
 .stats{gap:7px}.stat{padding:10px 5px}.stat strong{font-size:22px}.stat span{font-size:12px}
 .welcome,.box,.question{padding:16px;border-radius:16px}.welcome h2,.box h2{font-size:21px}.section-title{font-size:21px}
 .modegrid{grid-template-columns:1fr}.mode{display:flex;align-items:center;gap:12px;padding:13px}.mode .emoji{font-size:27px}.mode b{margin:0}.mode small{display:block}
 .pathcard{padding:14px}.pathcard b{font-size:17px}
 .qtext{font-size:19px}.choice{padding:12px;font-size:16px}
 .bottomnav{display:flex;position:fixed;z-index:10;bottom:0;left:0;right:0;background:rgba(255,255,255,.97);border-top:1px solid var(--line);padding:7px 5px calc(7px + env(safe-area-inset-bottom));justify-content:space-around;backdrop-filter:blur(12px)}
 .bottomnav button{background:transparent;color:#617789;padding:6px 4px;min-height:52px;flex:1;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:2px;border-radius:10px}
 .bottomnav button span{font-size:20px;line-height:1.2}.bottomnav button.active{background:var(--sky);color:var(--blue)}
 .toolbar button{flex:1}.navrow{position:sticky;bottom:72px;background:rgba(245,248,251,.95);padding:8px 0}
}
</style>
</head>
<body>
<header><div class="brand">Bộ ôn tập Giáo dục học</div><h1>Học dễ hiểu, nhớ lâu hơn</h1><p>Học từng phần nhỏ · Tự kiểm tra · Biết ngay mình đang yếu ở đâu.</p></header>
<main>
<section id="home" class="screen active">
 <div class="welcome"><span class="tag">LỘ TRÌNH ÔN TẬP</span><h2>Không cần học thuộc một lúc tất cả</h2><p>Chọn một chuyên đề, học từng ý ngắn, sau đó tự trả lời câu hỏi. Mỗi lần học chỉ cần tập trung một việc.</p>
 <div class="stats"><div class="stat"><strong id="sLearned">0</strong><span>Thẻ đã nhớ</span></div><div class="stat"><strong id="sBest">0%</strong><span>Điểm cao nhất</span></div><div class="stat"><strong id="sDone">0</strong><span>Lượt luyện</span></div></div>
 <div class="progress"><i id="progressBar" style="width:0%"></i></div><div class="note" id="progressText">Bắt đầu từ chuyên đề 1 nhé.</div></div>
 <h2 class="section-title">Lộ trình học</h2><p class="sub">Đi theo thứ tự này sẽ dễ hiểu và dễ nhớ hơn.</p>
 <div class="path">
  <button class="pathcard" onclick="openLesson(0)"><span class="num">01</span><span><b>Các lực lượng giáo dục</b><small>Nhà trường – Gia đình – Xã hội · Vai trò và phối hợp</small></span></button>
  <button class="pathcard" onclick="openLesson(1)"><span class="num">02</span><span><b>Bản chất và phương pháp giáo dục</b><small>Giáo dục là gì? Có đặc điểm gì? Dùng phương pháp nào?</small></span></button>
  <button class="pathcard" onclick="openLesson(2)"><span class="num">03</span><span><b>Hoạt động trải nghiệm, hướng nghiệp</b><small>Mục tiêu – Nội dung – Hình thức – Quy trình</small></span></button>
 </div>
 <h2 class="section-title">Khi đã học xong, luyện tập tại đây</h2><div class="modegrid">
  <button class="mode" onclick="go('cards')"><span class="emoji">🧠</span><span><b>Thẻ ghi nhớ</b><small>Che đáp án và tự nhớ lại</small></span></button>
  <button class="mode" onclick="startQuiz()"><span class="emoji">✍️</span><span><b>Trắc nghiệm</b><small>Mỗi lần 10 câu, có giải thích</small></span></button>
  <button class="mode" onclick="go('practice')"><span class="emoji">🎯</span><span><b>Luyện theo dạng</b><small>Điền khuyết, đúng/sai, tự luận</small></span></button>
 </div>
</section>
<section id="learn" class="screen"><div class="toolbar"><button class="outline" onclick="go('home')">← Trang chủ</button></div><div id="lessonArea"></div></section>
<section id="cardsScreen" class="screen"><div class="box"><span class="tag">GHI NHỚ CHỦ ĐỘNG</span><h2>Thẻ ghi nhớ</h2><p class="sub">Đọc câu hỏi, tự trả lời thành tiếng rồi mới bấm xem đáp án.</p><div class="qtop"><span id="cardCount"></span><span id="cardStatus">Chưa lật thẻ</span></div><div class="progress"><i id="cardProgress"></i></div><div class="flashcard"><div class="front" id="cardFront"></div><div class="back answer" id="cardBack"></div></div><div class="navrow"><button class="light" onclick="flip()">👀 Xem đáp án</button><button onclick="remember(true)">✓ Đã nhớ</button><button class="outline" onclick="remember(false)">↻ Chưa nhớ</button></div><div class="navrow"><button class="outline" onclick="cardMove(-1)">← Trước</button><button class="outline" onclick="cardMove(1)">Tiếp →</button></div></div></section>
<section id="quizScreen" class="screen"><div class="toolbar"><button class="outline" onclick="go('home')">← Trang chủ</button></div><div class="box"><span class="tag">KIỂM TRA KIẾN THỨC</span><h2>Trắc nghiệm 10 câu</h2><p class="sub">Làm từng câu một. Chọn đáp án rồi bấm kiểm tra để biết vì sao đúng hoặc sai.</p><div id="quizArea"></div></div></section>
<section id="practice" class="screen"><div class="box"><span class="tag">LUYỆN TẬP THEO DẠNG</span><h2>Chọn cách luyện phù hợp</h2><p class="sub">Mỗi dạng kiểm tra một kỹ năng khác nhau. Hãy làm lần lượt, không cần làm tất cả cùng lúc.</p><div class="modegrid">
<button class="mode" onclick="startFill()"><span class="emoji">🔤</span><span><b>Điền từ còn thiếu</b><small>Nhớ chính xác thuật ngữ và từ khóa</small></span></button>
<button class="mode" onclick="startTF()"><span class="emoji">☑️</span><span><b>Đúng hay sai?</b><small>Phân biệt nhận định đúng, sai</small></span></button>
<button class="mode" onclick="go('essayScreen')"><span class="emoji">📝</span><span><b>Tự luận</b><small>Học cách triển khai ý và lấy ví dụ</small></span></button>
</div></div><div id="practiceArea"></div></section>
<section id="essayScreen" class="screen"><div class="toolbar"><button class="outline" onclick="go('practice')">← Các dạng luyện tập</button></div><div class="box"><span class="tag">LUYỆN TRÌNH BÀY</span><h2>Câu hỏi tự luận</h2><p class="sub">Tự viết dàn ý trước. Sau đó mở gợi ý để so sánh xem mình thiếu ý nào.</p><div id="essayArea"></div></div></section>
</main>
<nav class="bottomnav">
