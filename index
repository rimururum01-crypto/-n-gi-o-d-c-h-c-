["Trình bày khái niệm và phân tích ba nhóm phương pháp giáo dục, kèm ví dụ.","Định nghĩa phương pháp giáo dục là cách thức phối hợp hoạt động giữa nhà giáo dục và người được giáo dục. Nhóm 1 hình thành ý thức: giảng giải, đàm thoại, kể chuyện, nêu gương. Nhóm 2 tổ chức hoạt động: luyện tập, rèn luyện, giao việc. Nhóm 3 kích thích/điều chỉnh: khen thưởng, trách phạt, thi đua. Dùng một chủ đề như trung thực để minh họa lần lượt cả ba nhóm."],
["Vì sao cần phối hợp nhiều phương pháp giáo dục? Nêu nguyên tắc lựa chọn.","Mỗi phương pháp có ưu điểm và giới hạn, tác động vào những mặt khác nhau. Cần kết hợp để người học vừa hiểu, vừa thực hành, vừa được phản hồi và điều chỉnh. Lựa chọn theo mục tiêu, nội dung, lứa tuổi, đặc điểm cá nhân, hoàn cảnh; phát huy tích cực, tự giác; linh hoạt, tôn trọng nhân cách và gắn thực tiễn."],
["Trình bày mục tiêu, bốn mạch nội dung và bốn loại hình tổ chức HĐTN-HN.","Mục tiêu là phát triển phẩm chất, năng lực qua trải nghiệm và vận dụng thực tiễn. Bốn mạch: bản thân, xã hội, tự nhiên, hướng nghiệp. Bốn loại hình: sinh hoạt dưới cờ, sinh hoạt lớp, hoạt động giáo dục theo chủ đề, câu lạc bộ. Nêu ví dụ ngắn cho từng mạch hoặc loại hình."],
["Phân tích nội dung cốt lõi của giáo dục hướng nghiệp.","Học sinh cần nhận thức bản thân (sở thích, năng lực, giá trị, điều kiện); tìm hiểu nghề và yêu cầu nghề; tìm hiểu thị trường lao động, xu hướng và cơ sở đào tạo; cân nhắc, lựa chọn hướng đi và lập kế hoạch học tập/rèn luyện. Nhấn mạnh lựa chọn có căn cứ, linh hoạt, phù hợp."],
["Phân tích vai trò của giáo viên và học sinh trong HĐTN-HN.","Giáo viên định hướng mục tiêu, thiết kế nhiệm vụ, tổ chức môi trường, hướng dẫn, hỗ trợ và đánh giá. Học sinh là chủ thể: chủ động tham gia, hợp tác, giải quyết vấn đề, chia sẻ, phản hồi, tự đánh giá và vận dụng. Giáo viên không làm thay, học sinh không thụ động."],
["Trình bày quy trình tổ chức một hoạt động trải nghiệm và minh họa.","Các bước: chuẩn bị/xác định mục tiêu; thiết kế nội dung, nhiệm vụ, phương tiện; tổ chức thực hiện; chia sẻ và phản hồi; đánh giá, rút kinh nghiệm và vận dụng. Ví dụ: khảo sát rác thải nhựa, đề xuất giải pháp, thử nghiệm, báo cáo và đánh giá."],
["Phân biệt ba nhóm phương pháp giáo dục bằng một tình huống sư phạm.","Chọn tình huống rèn tinh thần trách nhiệm. Hình thành ý thức: thảo luận ý nghĩa trách nhiệm, nêu gương. Tổ chức hoạt động: giao nhiệm vụ trực nhật/dự án và cho học sinh thực hiện. Kích thích, điều chỉnh: ghi nhận tiến bộ, phản hồi khi chưa hoàn thành, tổ chức thi đua lành mạnh. Chỉ rõ mục đích của từng nhóm."],
["Thiết kế một hoạt động HĐTN-HN theo chủ đề bảo vệ môi trường.","Mục tiêu: nâng nhận thức và hành vi bảo vệ môi trường. Chuẩn bị: chia nhóm, phiếu khảo sát, dụng cụ. Thực hiện: khảo sát rác, phân loại, đề xuất giải pháp, truyền thông hoặc thử nghiệm giảm nhựa. Chia sẻ: trình bày kết quả. Đánh giá: mức tham gia, giải pháp, thay đổi hành vi và kế hoạch duy trì."],
["Phân tích mối quan hệ giữa nhận thức, hành vi và thói quen trong quá trình giáo dục.","Nhận thức giúp người học hiểu điều đúng và lý do cần thực hiện; hoạt động tạo cơ hội chuyển hiểu biết thành hành vi; lặp lại và phản hồi phù hợp giúp hành vi ổn định thành thói quen. Cần kết hợp giải thích, thực hành, nêu gương và củng cố."],
["Một học sinh biết nội quy nhưng thường xuyên vi phạm. Hãy đề xuất cách giáo dục phù hợp.","Tìm hiểu nguyên nhân và hoàn cảnh; trao đổi tôn trọng; giúp học sinh hiểu ý nghĩa quy định; thống nhất mục tiêu nhỏ; giao nhiệm vụ/rèn luyện cụ thể; ghi nhận tiến bộ và phản hồi hành vi chưa phù hợp; phối hợp gia đình khi cần; khuyến khích tự đánh giá. Tránh chỉ trách phạt."],
["Giải thích vì sao hoạt động trải nghiệm không đồng nghĩa với hoạt động vui chơi tùy ý.","Trải nghiệm giáo dục phải có mục tiêu phát triển phẩm chất/năng lực, nội dung và nhiệm vụ phù hợp, sự tham gia chủ động, hướng dẫn và hỗ trợ, chia sẻ/phản hồi và đánh giá. Yếu tố vui vẻ có thể có nhưng không thay thế mục tiêu giáo dục."],
["Phân tích ý nghĩa của việc đánh giá trong HĐTN-HN.","Đánh giá giúp xác định mức đạt mục tiêu, ghi nhận quá trình và sự tiến bộ, nhận diện khó khăn, khuyến khích tự nhận thức, cải thiện hoạt động tiếp theo và định hướng vận dụng. Nên kết hợp tự đánh giá, đánh giá đồng đẳng và phản hồi của giáo viên."],
["So sánh vai trò của gia đình và nhà trường trong quá trình giáo dục.","Gia đình là môi trường đầu tiên, gần gũi, ảnh hưởng lâu dài đến nề nếp, tình cảm và thói quen. Nhà trường giữ vai trò chủ đạo trong giáo dục có mục đích, tổ chức và kế hoạch. Hai bên khác chức năng nhưng bổ sung cho nhau; cần thống nhất định hướng và trao đổi thường xuyên."]
];

let state=JSON.parse(localStorage.getItem("gd_hoc_mobile")||'{"learned":[],"best":0,"attempts":0,"missed":[]}');
let currentTopic=0,cardIndex=0,cardFlipped=false,quizSet=[],quizIndex=0,quizAnswers=[],quizChecked=false,fillIndex=0,tfIndex=0,essayIndex=0;
const $=id=>document.getElementById(id);
function save(){localStorage.setItem("gd_hoc_mobile",JSON.stringify(state));stats()}
function stats(){$("sLearned").textContent=state.learned.length;$("sBest").textContent=state.best+"%";$("sDone").textContent=state.attempts;$("progressBar").style.width=(state.learned.length/cards.length*100)+"%";$("progressText").textContent=state.learned.length+" / "+cards.length+" thẻ đã tự nhớ"}
function go(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));$(id==="cards"?"cardsScreen":id).classList.add("active");document.querySelectorAll(".bottomnav button").forEach(b=>b.classList.toggle("active",b.dataset.go===id||(id==="cards"&&b.dataset.go==="cardsScreen")));window.scrollTo({top:0,behavior:"smooth"});if(id==="cards")renderCard();if(id==="essayScreen")renderEssay()}
function openLesson(i){currentTopic=i;go("learn");renderLesson()}
function renderLesson(){let t=topics[currentTopic];$("lessonArea").innerHTML=`<div class="box"><span class="tag">CHUYÊN ĐỀ ${currentTopic+1}/3</span><h2>${t.title}</h2><p>${t.intro}</p><div class="remember"><b>Nhớ nhanh:</b> ${t.tag}</div><p class="sub">Học từng mục. Đọc phần giải thích trước, sau đó thử tự nói lại ý chính.</p></div><div class="lesson-list">${t.sections.map((s,i)=>`<details class="lesson" ${i===0?"open":""}><summary><span class="num">${String(i+1).padStart(2,"0")}</span>${s[0]}</summary><div class="lesson-content"><p>${s[1]}</p><div class="remember"><b>Ghi nhớ:</b><br>${s[2]}</div><button class="light" onclick="this.textContent=this.textContent.includes('Đã tự')?'Tôi chưa thuộc':'✓ Đã tự nhắc lại';this.classList.toggle('outline')">✓ Đã tự nhắc lại</button></div></details>`).join("")}</div><div class="navrow"><button class="outline" onclick="${currentTopic===0?"go('home')":`openLesson(${currentTopic-1})`}">← Trước</button><button onclick="${currentTopic===2?"go('cards')":`openLesson(${currentTopic+1})`}">${currentTopic===2?"Ôn thẻ ghi nhớ":"Chuyên đề tiếp →"}</button></div>`}
function renderCard(){let c=cards[cardIndex];$("cardCount").textContent=`Thẻ ${cardIndex+1}/${cards.length}`;$("cardProgress").style.width=((cardIndex+1)/cards.length*100)+"%";$("cardFront").textContent=c[0];$("cardBack").textContent=c[1];$("cardBack").classList.toggle("show",cardFlipped);$("cardStatus").textContent=cardFlipped?"Đã xem đáp án":"Hãy tự trả lời trước";$("cardBack").classList.toggle("answer",!cardFlipped)}
function flip(){cardFlipped=!cardFlipped;renderCard()}
function cardMove(d){cardIndex=(cardIndex+d+cards.length)%cards.length;cardFlipped=false;renderCard()}
function remember(ok){if(ok&&!state.learned.includes(cardIndex))state.learned.push(cardIndex);if(!ok)state.missed.push("card:"+cardIndex);save();cardMove(1)}
function startQuiz(){quizSet=[...mcqs].sort(()=>Math.random()-.5).slice(0,10);quizIndex=0;quizAnswers=Array(10).fill(null);quizChecked=false;go("quizScreen");renderQuiz()}
function renderQuiz(){let q=quizSet[quizIndex];$("quizArea").innerHTML=`<div class="progress"><i style="width:${(quizIndex+1)/10*100}%"></i></div><div class="qtop"><span>Câu ${quizIndex+1}/10</span><span>${quizChecked?"Đã kiểm tra":"Chưa trả lời"}</span></div><div class="qtext">${q[0]}</div>${q[1].map((v,j)=>`<label class="choice"><input type="radio" name="choice" value="${j}" ${quizAnswers[quizIndex]===j?"checked":""} ${quizChecked?"disabled":""}><span><b>${"ABCD"[j]}.</b> ${v}</span></label>`).join("")}${quizChecked?`<div class="feedback ${quizAnswers[quizIndex]===q[2]?"good":"bad"}"><b>${quizAnswers[quizIndex]===q[2]?"Chính xác!":"Chưa đúng."}</b><br>Đáp án đúng: ${"ABCD"[q[2]]}. ${q[1][q[2]]}<br>${q[3]}</div>`:""}<div class="navrow">${quizChecked?`<button onclick="nextQuiz()">${quizIndex===9?"Xem kết quả":"Câu tiếp theo →"}</button>`:`<button onclick="checkQuiz()">Kiểm tra đáp án</button>`}</div>`}
function checkQuiz(){let v=document.querySelector('input[name="choice"]:checked');if(!v){alert("Bạn hãy chọn một đáp án trước nhé.");return}quizAnswers[quizIndex]=Number(v.value);quizChecked=true;renderQuiz()}
function nextQuiz(){if(quizIndex<9){quizIndex++;quizChecked=false;renderQuiz();return}let score=quizSet.filter((q,i)=>quizAnswers[i]===q[2]).length;state.attempts++;state.best=Math.max(state.best,score*10);quizSet.forEach((q,i)=>{if(quizAnswers[i]!==q[2])state.missed.push(q[0])});save();$("quizArea").innerHTML=`<div class="question"><h2>Kết quả: ${score}/10</h2><p>${score>=8?"Rất tốt! Bạn đã nắm khá chắc phần này.":score>=6?"Khá rồi. Xem lại các câu sai và thử lượt khác nhé.":"Đừng lo. Quay lại học lý thuyết theo từng mục nhỏ rồi làm lại."}</p><div class="navrow"><button onclick="startQuiz()">Làm lượt mới</button><button class="light" onclick="go('learn')">Ôn lại lý thuyết</button></div></div>`}
function startFill(){go("practice");fillIndex=0;renderFill()}
function renderFill(){let q=blanks[fillIndex];$("practiceArea").innerHTML=`<div class="question"><div class="qtop"><span>ĐIỀN KHUYẾT · ${fillIndex+1}/${blanks.length}</span><span>Tự nhớ từ khóa</span></div><div class="qtext">${q[0]}</div><input class="field" id="fillInput" placeholder="Nhập từ còn thiếu"><div class="navrow"><button onclick="checkFill()">Kiểm tra</button><button class="outline" onclick="fillIndex=(fillIndex+1)%blanks.length;renderFill()">Bỏ qua</button></div><div id="fillFeedback"></div></div>`}
function checkFill(){let a=$("fillInput").value.trim().toLocaleLowerCase("vi"),q=blanks[fillIndex],ok=a===q[1].toLocaleLowerCase("vi")||(a.length>3&&q[1].toLocaleLowerCase("vi").includes(a));$("fillFeedback").innerHTML=`<div class="feedback ${ok?"good":"bad"}">${ok?"Chính xác!":"Đáp án tham khảo: "+q[1]}<br>${q[2]}</div><button style="margin-top:12px;width:100%" onclick="fillIndex=(fillIndex+1)%blanks.length;renderFill()">Câu tiếp theo →</button>`;state.attempts++;save()}
function startTF(){go("practice");tfIndex=0;renderTF()}
function renderTF(){let q=tf[tfIndex];$("practiceArea").innerHTML=`<div class="question"><div class="qtop"><span>ĐÚNG / SAI · ${tfIndex+1}/${tf.length}</span></div><div class="qtext">${q[0]}</div><div class="navrow"><button onclick="checkTF(true)">Đúng</button><button class="light" onclick="checkTF(false)">Sai</button></div><div id="tfFeedback"></div></div>`}
function checkTF(v){let q=tf[tfIndex],ok=v===q[1];$("tfFeedback").innerHTML=`<div class="feedback ${ok?"good":"bad"}">${ok?"Chính xác!":"Chưa đúng."}<br>${q[2]}</div><button style="margin-top:12px;width:100%" onclick="tfIndex=(tfIndex+1)%tf.length;renderTF()">Câu tiếp theo →</button>`;state.attempts++;save()}
function renderEssay(){let q=essays[essayIndex];$("essayArea").innerHTML=`<div class="qtop"><span>ĐỀ ${essayIndex+1}/${essays.length}</span><span>Tự trình bày</span></div><div class="qtext">${q[0]}</div><textarea class="field" placeholder="Viết dàn ý hoặc câu trả lời của bạn ở đây..."></textarea><button class="light" style="width:100%;margin-top:12px" onclick="document.getElementById('essayAnswer').classList.toggle('show')">Mở dàn ý tham khảo</button><div class="answer explain" id="essayAnswer">${q[1]}</div><div class="navrow"><button class="outline" onclick="essayIndex=(essayIndex-1+essays.length)%essays.length;renderEssay()">← Đề trước</button><button onclick="essayIndex=(essayIndex+1)%essays.length;renderEssay()">Đề tiếp →</button></div>`}
stats();
</script>
</body></html>
