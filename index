<button data-go="cardsScreen" onclick="go('cards')"><span>🧠</span>Thẻ nhớ</button>
<button data-go="quizScreen" onclick="startQuiz()"><span>✍️</span>Kiểm tra</button>
<button data-go="practice" onclick="go('practice')"><span>☰</span>Luyện tập</button>
</nav>
<script>
const topics=[
{title:"1. Tác động của các lực lượng giáo dục",tag:"Nhà trường – Gia đình – Xã hội",intro:"Nhân cách người học không hình thành từ một phía. Nhiều lực lượng cùng tác động, hỗ trợ hoặc đôi khi tạo ảnh hưởng khác nhau; vì vậy cần phối hợp thống nhất.",sections:[
["Khái niệm và các lực lượng","Lực lượng giáo dục là những chủ thể, tổ chức và môi trường tham gia tác động đến quá trình hình thành, phát triển nhân cách người học.","Ba lực lượng cơ bản thường được nhấn mạnh là nhà trường, gia đình và xã hội."],
["Nhà trường","Nhà trường giữ vai trò chủ đạo trong giáo dục có mục đích, có tổ chức và kế hoạch. Nhà trường xây dựng mục tiêu, nội dung, phương pháp; tổ chức dạy học và giáo dục; phối hợp với gia đình, xã hội; theo dõi và đánh giá sự tiến bộ của người học.","Từ khóa: CHỦ ĐẠO – CÓ KẾ HOẠCH – TỔ CHỨC."],
["Gia đình","Gia đình là môi trường giáo dục đầu tiên, gần gũi và có ảnh hưởng lâu dài. Gia đình hình thành nề nếp, thói quen, tình cảm, cách ứng xử; chăm sóc và tạo điều kiện học tập; phối hợp với nhà trường.","Từ khóa: ĐẦU TIÊN – GẦN GŨI – LÂU DÀI."],
["Xã hội","Xã hội tạo môi trường, điều kiện và cơ hội để người học tiếp xúc với đời sống thực tiễn. Các tổ chức, cộng đồng, đoàn thể, truyền thông và môi trường văn hóa có thể góp phần giáo dục hoặc tạo ảnh hưởng tiêu cực cần định hướng.","Từ khóa: MÔI TRƯỜNG – ĐIỀU KIỆN – CƠ HỘI THỰC TIỄN."],
["Mối quan hệ giữa ba lực lượng","Ba lực lượng không hoạt động tách biệt. Tác động có thể bổ sung, hỗ trợ nhau; nếu thiếu thống nhất có thể gây mâu thuẫn trong nhận thức và hành vi của người học.","Ví dụ: nhà trường rèn tính trung thực, gia đình cần làm gương và xã hội cần tôn trọng sự trung thực."],
["Nguyên tắc phối hợp","Thống nhất mục tiêu và định hướng giáo dục; trao đổi thông tin thường xuyên; phối hợp chặt chẽ nhưng tôn trọng chức năng của mỗi bên; phát huy vai trò chủ động của người học; kịp thời xử lý ảnh hưởng không phù hợp.","Công thức nhớ: THỐNG NHẤT – THƯỜNG XUYÊN – CHẶT CHẼ – ĐÚNG VAI TRÒ."],
["Ý nghĩa và ví dụ vận dụng","Sự phối hợp tạo môi trường giáo dục đồng bộ, củng cố điều tốt, hạn chế tác động xấu và giúp người học vận dụng điều đã học vào đời sống.","Khi học sinh có biểu hiện đi học muộn: giáo viên tìm hiểu nguyên nhân, trao đổi phụ huynh, gia đình điều chỉnh nề nếp, đoàn thể hỗ trợ nếu cần; tránh chỉ phê bình một chiều."]
]},
{title:"2. Bản chất và phương pháp giáo dục",tag:"Mục đích – Tương tác – Hoạt động – Hành vi",intro:"Giáo dục không đơn thuần là nói cho người học biết điều đúng. Giáo dục phải tổ chức cho người học hiểu, tin, thực hành và dần biến điều đúng thành hành vi, thói quen.",sections:[
["Bản chất quá trình giáo dục","Quá trình giáo dục là quá trình tổ chức các tác động có mục đích, có kế hoạch và có tổ chức của nhà giáo dục, nhằm hình thành và phát triển phẩm chất, nhân cách người học.","Cần nhớ: giáo dục hướng tới sự biến đổi bên trong và biểu hiện ra hành vi; không chỉ dừng ở việc truyền đạt thông tin."],
["Đặc điểm của quá trình giáo dục","Có mục đích và định hướng; diễn ra thông qua sự tương tác giữa nhà giáo dục và người được giáo dục; gắn với hoạt động và giao tiếp; diễn ra lâu dài, liên tục; chịu ảnh hưởng của đặc điểm cá nhân và hoàn cảnh; đòi hỏi người học tự giác, tự giáo dục.","Mẹo nhớ 6 ý: MỤC ĐÍCH – TƯƠNG TÁC – HOẠT ĐỘNG – LÂU DÀI – CÁ BIỆT – TỰ GIÁO DỤC."],
["Các con đường giáo dục","Tác động giáo dục cần thông qua hoạt động, giao tiếp và sự tự giáo dục của cá nhân. Người học hình thành kinh nghiệm khi tham gia việc thật, tương tác với người khác, suy ngẫm và tự điều chỉnh.","Ví dụ: muốn rèn tinh thần trách nhiệm, hãy giao nhiệm vụ cụ thể, cho người học thực hiện, phản hồi và tự đánh giá."],
["Khái niệm phương pháp giáo dục","Phương pháp giáo dục là cách thức phối hợp hoạt động giữa nhà giáo dục và người được giáo dục nhằm thực hiện mục tiêu giáo dục.","Phương pháp trả lời câu hỏi: giáo dục bằng cách nào?"],
["Nhóm phương pháp hình thành ý thức cá nhân","Giúp người học nhận thức đúng, hiểu chuẩn mực, hình thành quan điểm và thái độ. Ví dụ: giảng giải, đàm thoại, kể chuyện, nêu gương, tranh luận.","Từ khóa: NÓI – GIẢI THÍCH – THUYẾT PHỤC – NÊU GƯƠNG."],
["Nhóm phương pháp tổ chức hoạt động và hình thành kinh nghiệm hành vi","Tạo cơ hội để người học thực hành, rèn luyện và hình thành hành vi, thói quen. Ví dụ: luyện tập, rèn luyện, giao việc, tổ chức hoạt động, tập thói quen.","Từ khóa: LÀM – LUYỆN – LẶP LẠI – THÀNH THÓI QUEN."],
["Nhóm phương pháp kích thích và điều chỉnh hành vi","Tác động nhằm khuyến khích hành vi tích cực, điều chỉnh hành vi chưa phù hợp. Ví dụ: khen thưởng, trách phạt, thi đua.","Từ khóa: ĐỘNG VIÊN – NHẮC NHỞ – ĐIỀU CHỈNH."],
["Lựa chọn và phối hợp phương pháp","Cần căn cứ mục tiêu, nội dung, lứa tuổi, đặc điểm cá nhân và hoàn cảnh; phát huy tính tích cực, tự giác; kết hợp linh hoạt nhiều phương pháp; tôn trọng người học và gắn với thực tiễn.","Không có một phương pháp duy nhất phù hợp mọi đối tượng và mọi tình huống."],
["Phân biệt ba nhóm qua ví dụ","Giáo viên kể câu chuyện về lòng trung thực: hình thành ý thức. Học sinh thực hiện cam kết trung thực trong một dự án: tổ chức hoạt động. Giáo viên tuyên dương hành vi trung thực và góp ý khi vi phạm: kích thích, điều chỉnh.","Mẹo phân loại: NGHE/HIỂU = ý thức; TỰ LÀM = hoạt động; ĐƯỢC KHUYẾN KHÍCH/ĐIỀU CHỈNH = kích thích."]
]},
{title:"3. Hoạt động trải nghiệm, hướng nghiệp",tag:"Trải nghiệm – Vận dụng – Phát triển năng lực",intro:"Người học phát triển phẩm chất và năng lực bằng cách tham gia hoạt động thực tiễn, trải nghiệm, suy ngẫm, chia sẻ và vận dụng điều đã học.",sections:[
["Khái niệm và mục tiêu","Hoạt động trải nghiệm, hướng nghiệp là hoạt động giáo dục được tổ chức để học sinh tiếp cận thực tiễn, huy động kinh nghiệm cá nhân, tham gia hoạt động và vận dụng kiến thức, kỹ năng vào đời sống; qua đó phát triển phẩm chất và năng lực.","Không đồng nhất trải nghiệm với vui chơi tự do: hoạt động cần mục tiêu, nhiệm vụ, tổ chức và đánh giá."],
["Bốn mạch nội dung","Hướng vào bản thân; hướng đến xã hội; hướng đến tự nhiên; hướng nghiệp.","Mẹo nhớ: MÌNH – NGƯỜI – THIÊN NHIÊN – NGHỀ."],
["Bốn loại hình tổ chức cơ bản","Sinh hoạt dưới cờ; sinh hoạt lớp; hoạt động giáo dục theo chủ đề; hoạt động câu lạc bộ.","Mẹo nhớ: CỜ – LỚP – CHỦ ĐỀ – CLB."],
["Nội dung hướng vào bản thân","Nhận thức bản thân; rèn luyện nền nếp, kỹ năng; chăm sóc bản thân; quản lý cảm xúc, thời gian và phát triển điểm mạnh.","Câu hỏi tự kiểm: Tôi là ai? Tôi có điểm mạnh, điểm cần cải thiện nào?"],
["Nội dung hướng đến xã hội","Xây dựng quan hệ với gia đình, thầy cô, bạn bè và cộng đồng; giao tiếp, hợp tác; tham gia hoạt động xã hội; thực hiện trách nhiệm và ứng xử phù hợp.","Tập trung vào quan hệ, trách nhiệm và đóng góp với cộng đồng."],
["Nội dung hướng đến tự nhiên","Tìm hiểu môi trường tự nhiên; bảo vệ môi trường; ứng phó với biến đổi khí hậu và tham gia hoạt động vì thiên nhiên.","Gắn nhận thức môi trường với hành động cụ thể."],
["Nội dung hướng nghiệp","Tìm hiểu bản thân; tìm hiểu nghề nghiệp và yêu cầu nghề; tìm hiểu thị trường lao động, cơ sở đào tạo; lựa chọn hướng học tập/nghề nghiệp và lập kế hoạch.","Mẹo nhớ 4 bước: HIỂU MÌNH – HIỂU NGHỀ – TÌM CƠ HỘI – LẬP KẾ HOẠCH."],
["Vai trò của giáo viên và học sinh","Giáo viên định hướng, thiết kế, tổ chức, hướng dẫn, hỗ trợ và đánh giá. Học sinh là chủ thể tích cực: tham gia, hợp tác, giải quyết vấn đề, chia sẻ, phản hồi và tự đánh giá.","Giáo viên không làm thay; học sinh không chỉ ngồi nghe."],
["Quy trình tổ chức hoạt động","Chuẩn bị/xác định mục tiêu; thiết kế hoạt động và nhiệm vụ; tổ chức thực hiện; chia sẻ, phản hồi; đánh giá và vận dụng.","Mẹo nhớ: CHUẨN BỊ – THIẾT KẾ – LÀM – CHIA SẺ – ĐÁNH GIÁ."],
["Ví dụ một hoạt động trải nghiệm","Chủ đề: giảm rác thải nhựa trong trường. Học sinh khảo sát, thống kê, đề xuất giải pháp, truyền thông, thử nghiệm trong một tuần, báo cáo kết quả và tự đánh giá.","Ví dụ này có đủ trải nghiệm thực tế, hợp tác, giải quyết vấn đề và vận dụng."]
]}];
